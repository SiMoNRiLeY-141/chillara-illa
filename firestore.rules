rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every application record is stored beneath the authenticated owner's UID.
    // The UID is derived from Firebase Authentication, never client input.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all paths not explicitly granted above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
