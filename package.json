{
  "name": "chillara-illa",
  "version": "1.0.0",
  "description": "Chillara Illa - Premium Commercial Invoicing SaaS App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dev-server": "nodemon server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.chillarailla.app",
    "productName": "Chillara Illa",
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "allowScripts": {
    "electron@25.9.8": true,
    "sqlite3@5.1.7": true
  }
}
